@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<section class="dsc-card">

    <h2 class="dsc-card__title">Senha</h2>

    <p class="dsc-card__text">
        Escolha uma senha nova para a sua conta.
    </p>

    <form id="change-password-form" method="post">

        <div asp-validation-summary="ModelOnly"
             class="dsc-alert"
             role="alert"></div>

        <div class="dsc-field">

            <input asp-for="Input.OldPassword"
                   class="dsc-field__input"
                   autocomplete="current-password"
                   aria-required="true"
                   placeholder=" " />

            <label asp-for="Input.OldPassword" class="dsc-field__label">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <span>Senha atual</span>
            </label>

            <span asp-validation-for="Input.OldPassword" class="dsc-field__error"></span>

        </div>

        <div class="dsc-field">

            <input asp-for="Input.NewPassword"
                   class="dsc-field__input"
                   autocomplete="new-password"
                   aria-required="true"
                   placeholder=" " />

            <label asp-for="Input.NewPassword" class="dsc-field__label">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <span>Nova senha</span>
            </label>

            <span asp-validation-for="Input.NewPassword" class="dsc-field__error"></span>

            <span class="form-hint">
                Pelo menos 6 caracteres, com letra maiúscula, minúscula, número e símbolo.
            </span>

        </div>

        <div class="dsc-field">

            <input asp-for="Input.ConfirmPassword"
                   class="dsc-field__input"
                   autocomplete="new-password"
                   aria-required="true"
                   placeholder=" " />

            <label asp-for="Input.ConfirmPassword" class="dsc-field__label">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                <span>Confirmar nova senha</span>
            </label>

            <span asp-validation-for="Input.ConfirmPassword" class="dsc-field__error"></span>

        </div>

        <button type="submit"
                class="form-submit"
                data-loading-text="Salvando…">
            Atualizar senha
        </button>

    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}