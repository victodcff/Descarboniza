@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Verifique seu e-mail";
}

<div class="dsc-auth">

    <div class="dsc-auth__card">

        <a asp-controller="Home"
           asp-action="Index"
           class="dsc-auth__brand dsc-brand">

            <img class="dsc-logo dsc-logo--lg"
                 src="~/img/logo.png"
                 alt=""
                 asp-append-version="true" />

            <b class="dsc-brand__text"><span>DES</span>CARBONIZA</b>

        </a>

        <h1 class="dsc-auth__title">Verifique seu e-mail</h1>

        <p class="dsc-auth__subtitle">
            Se o e-mail informado estiver cadastrado, enviamos um link para redefinir a senha.
            Ele vale por 1 hora. Se não chegar em alguns minutos, olhe também a caixa de spam.
        </p>

        <p class="dsc-auth__switch">
            <a asp-page="./Login">Voltar para o login</a>
        </p>

    </div>

</div>
