@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Nova senha";
}

<div class="dsc-auth">

    <div class="dsc-auth__card">

        <a asp-controller="Home"
           asp-action="Index"
           class="dsc-auth__brand dsc-brand">

            <img class="dsc-logo dsc-logo--lg"
                 src="~/img/logo.png"
                 alt=""
                 asp-append-version="true" />

            <b class="dsc-brand__text"><span>DES</span>CARBONIZA</b>

        </a>

        <h1 class="dsc-auth__title">Nova senha</h1>

        <p class="dsc-auth__subtitle">
            Confirme o seu e-mail e escolha uma nova senha para a sua conta.
        </p>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="dsc-alert"
                 role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="dsc-field">

                <input asp-for="Input.Email"
                       class="dsc-field__input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder=" " />

                <label asp-for="Input.Email" class="dsc-field__label">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                    <span>E-mail</span>
                </label>

                <span asp-validation-for="Input.Email" class="dsc-field__error"></span>

            </div>

            <div class="dsc-field">

                <input asp-for="Input.Password"
                       class="dsc-field__input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder=" " />

                <label asp-for="Input.Password" class="dsc-field__label">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="4" y="11" width="16" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    <span>Nova senha</span>
                </label>

                <span asp-validation-for="Input.Password" class="dsc-field__error"></span>

            </div>

            <div class="dsc-field">

                <input asp-for="Input.ConfirmPassword"
                       class="dsc-field__input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder=" " />

                <label asp-for="Input.ConfirmPassword" class="dsc-field__label">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="4" y="11" width="16" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    <span>Confirmar nova senha</span>
                </label>

                <span asp-validation-for="Input.ConfirmPassword" class="dsc-field__error"></span>

            </div>

            <button type="submit"
                    class="form-submit dsc-btn-block"
                    data-loading-text="Salvando…">
                Salvar nova senha
            </button>

        </form>

        <p class="dsc-auth__switch">
            <a asp-page="./Login">Voltar para o login</a>
        </p>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
