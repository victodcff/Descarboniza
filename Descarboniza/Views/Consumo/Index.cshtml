@model IEnumerable<Descarboniza.Areas.Identity.Data.Consumo>

@{
    ViewData["Title"] = "Consumos";
}

<div class="data-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">GESTÃO ENERGÉTICA</span>

            <h1>Meus consumos</h1>

            <p class="data-page-description">
                Registre e acompanhe o consumo energético dos seus equipamentos.
            </p>
        </div>

        <a asp-action="Create" class="data-page-action">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>

            Novo consumo
        </a>
    </div>


    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th>Registro</th>
                        <th class="text-end">Horas/dia</th>
                        <th class="text-end">Dias/mês</th>
                        <th class="text-end">Consumo</th>
                        <th class="text-end">Tarifa</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <div class="table-entity">

                                        <div class="table-entity-icon">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 2v4" />
                                                <path d="M12 18v4" />
                                                <path d="M2 12h4" />
                                                <path d="M18 12h4" />
                                                <circle cx="12" cy="12" r="5" />
                                            </svg>
                                        </div>

                                        <div>
                                            <span class="table-primary-text">
                                                @(item.Maquina != null
                                                    ? item.Maquina.Fabricante
                                                    : "Máquina não encontrada")
                                            </span>

                                            <span class="table-secondary-text">
                                                @(item.Maquina != null
                                                    ? item.Maquina.Modelo
                                                    : "Registro sem máquina")
                                            </span>
                                        </div>

                                    </div>
                                </td>

                                <td class="table-date">
                                    @item.DataRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="table-number">
                                    @item.HorasUsoDia.ToString("N2")
                                    <span class="table-unit">h</span>
                                </td>

                                <td class="table-number">
                                    @item.DiasUsoMes.ToString("N0")
                                    <span class="table-unit">dias</span>
                                </td>

                                <td class="table-number">
                                    <span class="table-primary-text">
                                        @item.ConsumoKwhMes.ToString("N2")
                                    </span>

                                    <span class="table-unit">
                                        kWh
                                    </span>
                                </td>

                                <td class="table-number">
                                    R$ @item.TarifaKwh.ToString("N2")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdConsumo"
                                           class="table-action edit"
                                           title="Editar"
                                           aria-label="Editar consumo">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>

                                        </a>


                                        <a asp-action="Details"
                                           asp-route-id="@item.IdConsumo"
                                           class="table-action view"
                                           title="Visualizar"
                                           aria-label="Visualizar consumo">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>

                                        </a>


                                        <a asp-action="Analise"
                                           asp-route-id="@item.IdConsumo"
                                           class="table-action analyze"
                                           title="Analisar"
                                           aria-label="Analisar consumo">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M4 19V5" />
                                                <path d="M4 19h16" />
                                                <path d="m7 15 4-4 3 2 5-6" />
                                            </svg>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdConsumo"
                                           class="table-action delete"
                                           title="Excluir"
                                           aria-label="Excluir consumo">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5" />
                                                <path d="M14 11v5" />
                                            </svg>

                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="table-empty">

                                <div class="table-empty-icon">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.7"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M12 2v4" />
                                        <path d="M12 18v4" />
                                        <path d="M2 12h4" />
                                        <path d="M18 12h4" />
                                        <circle cx="12" cy="12" r="5" />
                                    </svg>
                                </div>

                                <div class="table-empty-title">
                                    Nenhum consumo registrado
                                </div>

                                <div class="table-empty-text">
                                    Registre seu primeiro consumo para começar.
                                </div>

                                <a asp-action="Create" class="table-empty-action">
                                    Registrar consumo
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="table-footer">
            <span>
                @Model.Count() consumo(s) registrado(s)
            </span>
        </div>

    </div>

</div>