@model Descarboniza.Areas.Identity.Data.Consumo

@{
    ViewData["Title"] = "Novo Consumo";
}

<div class="data-page consumo-form-page">

    <div class="data-page-header">

        <div class="data-page-title-wrap">

            <span class="data-page-kicker">GESTÃO ENERGÉTICA</span>

            <h1>Novo consumo</h1>

            <p class="data-page-description">
                Registre os dados de utilização e consumo do equipamento.
            </p>

        </div>

    </div>


    <div class="data-form-card">

        <form asp-action="Create" id="createForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>


            <div class="form-section">

                <div class="form-section-title">
                    Equipamento
                </div>

                <div class="form-group">

                    <label asp-for="IdMaquina" class="form-label">
                        Máquina
                    </label>

                    <select asp-for="IdMaquina"
                            class="form-control">

                        <option value="0">
                            -- Selecione uma máquina --
                        </option>

                        @foreach (var maquina in ViewBag.Maquinas)
                        {
                            <option value="@maquina.IdMaquina"
                                    data-potencia="@(((double)maquina.Potencia).ToString("R", System.Globalization.CultureInfo.InvariantCulture))">
                                @maquina.Fabricante - @maquina.Modelo
                            </option>
                        }

                    </select>

                    <span asp-validation-for="IdMaquina"
                          class="text-danger"></span>

                </div>

            </div>


            <div class="form-section">

                <div class="form-section-title">
                    Registro
                </div>

                <div class="form-group">

                    <label class="form-label" for="DataAutomatica">
                        Data do registro
                    </label>

                    <input type="text"
                           id="DataAutomatica"
                           class="form-control"
                           data-relogio
                           readonly
                           tabindex="-1" />

                    <span class="form-hint">
                        Preenchida automaticamente ao salvar.
                    </span>

                </div>

            </div>


            <div class="form-section">

                <div class="form-section-title">
                    Utilização
                </div>

                <div class="form-grid-2">

                    <div class="form-group">

                        <label asp-for="HorasUsoDia" class="form-label">
                            Horas por dia
                        </label>

                        <div class="input-with-unit">

                            <input asp-for="HorasUsoDia"
                                   type="text"
                                   inputmode="decimal"
                                   class="form-control decimal"
                                   placeholder="0,00"
                                   data-val="false" />

                            <span>h</span>

                        </div>

                        <span asp-validation-for="HorasUsoDia"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="DiasUsoMes" class="form-label">
                            Dias por mês
                        </label>

                        <div class="input-with-unit">

                            <input asp-for="DiasUsoMes"
                                   type="text"
                                   inputmode="decimal"
                                   class="form-control decimal"
                                   placeholder="0"
                                   data-val="false" />

                            <span>dias</span>

                        </div>

                        <span asp-validation-for="DiasUsoMes"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>


            <div class="form-section">

                <div class="form-section-title">
                    Consumo estimado
                </div>

                <div class="form-grid-2">

                    <div class="form-group">

                        <label class="form-label" for="consumoCalculado">
                            Consumo mensal
                        </label>

                        <div class="input-with-unit">

                            <input type="text"
                                   id="consumoCalculado"
                                   class="form-control"
                                   value="—"
                                   data-fator="@(Descarboniza.Services.EmissaoCarbonoService.FatorEmissaoPadrao.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                   readonly
                                   tabindex="-1" />

                            <span>kWh</span>

                        </div>

                        <span class="form-hint">
                            Calculado automaticamente: potência da máquina × horas por dia × dias por mês.
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="TarifaKwh" class="form-label">
                            Tarifa
                        </label>

                        <div class="input-with-unit">

                            <input asp-for="TarifaKwh"
                                   type="text"
                                   inputmode="decimal"
                                   class="form-control decimal"
                                   placeholder="0,00"
                                   data-val="false" />

                            <span>R$/kWh</span>

                        </div>

                        <span asp-validation-for="TarifaKwh"
                              class="text-danger"></span>

                    </div>

                </div>

                <span class="form-hint"
                      id="estimativa"
                      style="display:block;margin-top:10px"
                      aria-live="polite"></span>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="form-cancel">
                    Cancelar
                </a>

                <button type="submit"
                        class="form-submit">
                    Registrar consumo
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document
            .querySelectorAll(".decimal")
            .forEach(function (campo) {

                campo.value = campo.value.replace(".", ",");

            });


        document
            .getElementById("createForm")
            .addEventListener("submit", function () {

                document
                    .querySelectorAll(".decimal")
                    .forEach(function (campo) {

                        campo.value =
                            campo.value.replace(".", ",");

                    });

            });

    </script>

    <script>

        (function () {

            var selecao = document.getElementById("IdMaquina");
            var horas = document.getElementById("HorasUsoDia");
            var dias = document.getElementById("DiasUsoMes");
            var tarifa = document.getElementById("TarifaKwh");
            var saida = document.getElementById("consumoCalculado");
            var estimativa = document.getElementById("estimativa");

            if (!selecao || !horas || !dias || !tarifa || !saida || !estimativa) {
                return;
            }

            var fator = parseFloat(saida.getAttribute("data-fator")) || 0;

            function numero(valor) {
                var n = parseFloat(String(valor).replace(",", "."));
                return isNaN(n) ? 0 : n;
            }

            function formatar(n) {
                return n.toLocaleString("pt-BR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function atualizar() {

                var opcao = selecao.options[selecao.selectedIndex];
                var potencia = opcao ? numero(opcao.getAttribute("data-potencia")) : 0;
                var kwh = potencia * numero(horas.value) * numero(dias.value);

                if (potencia <= 0 || kwh <= 0) {
                    saida.value = "—";
                    estimativa.textContent = "";
                    return;
                }

                saida.value = formatar(kwh);

                estimativa.textContent =
                    "Custo estimado: R$ " + formatar(kwh * numero(tarifa.value)) +
                    " por mês  ·  Emissão estimada: " + formatar(kwh * fator) +
                    " kg CO₂ por mês";
            }

            [selecao, horas, dias, tarifa].forEach(function (campo) {
                campo.addEventListener("input", atualizar);
                campo.addEventListener("change", atualizar);
            });

            atualizar();

        })();

    </script>
}
