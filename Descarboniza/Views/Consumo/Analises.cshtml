@model List<Descarboniza.ViewModels.ResumoConsumoViewModel>

@{
    ViewData["Title"] = "Análises";
}

<link rel="stylesheet" href="~/css/analise.css" asp-append-version="true" />

<style>
    /* Mantém o nome e o modelo alinhados verticalmente ao ícone de cada máquina. */
    .an-list .data-table tbody td {
        vertical-align: middle;
    }

    .an-list .table-entity {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

        .an-list .table-entity > div:last-child {
            min-width: 0;
        }

    .an-list .table-primary-text {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        line-height: 1.35;
    }

    .an-list .table-secondary-text {
        display: block;
        margin-top: 4px;
        line-height: 1.3;
    }
</style>

<div class="data-page an-list">

    <div class="data-page-header">

        <div class="data-page-title-wrap">

            <span class="data-page-kicker">ANÁLISE ENERGÉTICA</span>

            <h1>Análises</h1>

            <p class="data-page-description">
                Veja quanto cada equipamento consome, custa e emite por mês. O de maior consumo aparece primeiro.
            </p>

        </div>

    </div>


    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th class="table-number">Consumo</th>
                        <th class="table-number">Custo mensal</th>
                        <th class="table-number">Emissão</th>
                        <th style="text-align:center;">% consumo total</th>
                        <th class="table-number">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="table-empty">

                                <div class="table-empty-icon">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M4 19V5" />
                                        <path d="M4 19h16" />
                                        <path d="M7 15l3-4 3 2 5-7" />
                                    </svg>
                                </div>

                                <div class="table-empty-title">
                                    Nenhuma análise disponível
                                </div>

                                <div class="table-empty-text">
                                    Registre o consumo de uma máquina para ver a análise.
                                </div>

                                <a asp-action="Create"
                                   class="table-empty-action">
                                    Registrar consumo
                                </a>

                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="table-entity">

                                    <div class="table-entity-icon">
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M4 19V5" />
                                            <path d="M4 19h16" />
                                            <path d="M7 15l3-4 3 2 5-7" />
                                        </svg>
                                    </div>

                                    <div>
                                        <span class="table-primary-text">
                                            @item.Fabricante
                                            @if (Model.Count > 1 && ReferenceEquals(item, Model[0]))
                                            {
                                                <span class="an-top">Maior consumo</span>
                                            }
                                        </span>
                                        <span class="table-secondary-text">@item.Modelo</span>
                                    </div>

                                </div>
                            </td>

                            <td class="table-number">
                                @item.ConsumoKwhMes.ToString("N2")
                                <span class="table-unit">kWh</span>
                            </td>

                            <td class="table-number">
                                R$ @item.CustoMensal.ToString("N2")
                            </td>

                            <td class="table-number">
                                @item.EmissaoKgCo2.ToString("N2")
                                <span class="table-unit">kg CO₂</span>
                            </td>

                            <td>
                                <div class="an-share">
                                    <span class="an-share__valor">@item.ParticipacaoPercentual.ToString("N1")%</span>
                                    <div class="an-bar an-bar--sm">
                                        <span style="width:@(Math.Min(100, item.ParticipacaoPercentual).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="table-actions">

                                    <a asp-action="Analise"
                                       asp-route-id="@item.IdConsumo"
                                       class="table-action analyze"
                                       title="Ver análise"
                                       aria-label="Ver análise">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M4 19V5" />
                                            <path d="M4 19h16" />
                                            <path d="M7 15l3-4 3 2 5-7" />
                                        </svg>

                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="table-footer">
            <span>@Model.Count análise(s)</span>
        </div>

    </div>

</div>