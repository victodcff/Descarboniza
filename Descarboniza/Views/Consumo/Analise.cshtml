@model Descarboniza.ViewModels.AnaliseConsumoViewModel

@{
    ViewData["Title"] = "Análise de Consumo";

    var consumo = Model.Consumo;
    var maquina = consumo.Maquina;

    var invariante = System.Globalization.CultureInfo.InvariantCulture;
    var larguraParticipacao = Math.Min(100, Math.Max(0, Model.ParticipacaoPercentual)).ToString("0.##", invariante);
}

<link rel="stylesheet" href="~/css/analise.css" asp-append-version="true" />

<div class="data-page analise-page an-page">

    <div class="data-page-header">

        <div class="data-page-title-wrap">

            <span class="data-page-kicker">ANÁLISE ENERGÉTICA</span>

            <h1>Análise de Consumo</h1>

            <p class="data-page-description">
                Avaliação do consumo energético e dos custos da máquina.
            </p>

        </div>

    </div>


    @if (maquina != null)
    {
        <section class="an-machine">

            <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 8h10" /><path d="M7 12h4" /><path d="M7 16h7" /></svg></span>

            <div class="an-machine__info">
                <span class="an-kicker">Máquina analisada</span>
                <h2>@maquina.Fabricante - @maquina.Modelo</h2>
            </div>

            <ul class="an-specs">
                <li>
                    <span>Potência</span>
                    <strong>@maquina.Potencia.ToString("N2") <small>kW</small></strong>
                </li>
                <li>
                    <span>Tensão</span>
                    <strong>@maquina.Tensao.ToString("N2") <small>V</small></strong>
                </li>
                <li>
                    <span>Corrente</span>
                    <strong>@maquina.Corrente.ToString("N2") <small>A</small></strong>
                </li>
            </ul>

        </section>
    }
    else
    {
        <div class="an-warning">
            <strong>Máquina não encontrada.</strong>
            Não foi possível carregar os dados da máquina deste consumo.
        </div>
    }


    <div class="an-kpis">

        <div class="an-kpi">
            <div class="an-kpi__topo">
                <span class="an-kpi__rotulo">Emissão de CO₂</span>
                <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg></span>
            </div>
            <div class="an-kpi__valor">
                @Model.EmissaoMensal.ToString("N2")<small>kg CO₂/mês</small>
            </div>
            <span class="an-kpi__nota">@Model.EmissaoAnual.ToString("N2") kg CO₂ por ano</span>
        </div>

        <div class="an-kpi">
            <div class="an-kpi__topo">
                <span class="an-kpi__rotulo">Custo mensal</span>
                <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1" /><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" /></svg></span>
            </div>
            <div class="an-kpi__valor">R$ @Model.CustoMensal.ToString("N2")</div>
            <span class="an-kpi__nota">R$ @Model.CustoAnual.ToString("N2") por ano</span>
        </div>

        <div class="an-kpi">
            <div class="an-kpi__topo">
                <span class="an-kpi__rotulo">% do consumo total</span>
                <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.21 15.89A10 10 0 1 1 8 2.83" /><path d="M22 12A10 10 0 0 0 12 2v10z" /></svg></span>
            </div>
            <div class="an-kpi__valor">@Model.ParticipacaoPercentual.ToString("N1")<small>%</small></div>
            <div class="an-bar">
                <span style="width:@(larguraParticipacao)%;"></span>
            </div>
            <span class="an-kpi__nota">da energia de todas as suas máquinas</span>
        </div>

    </div>

    <details class="an-panel">

        <summary>

            <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>

            <span class="an-panel__texto">
                <span class="an-kicker">DADOS REGISTRADOS</span>
                <h2>Utilização</h2>
            </span>

            <span class="an-panel__seta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span>

        </summary>

        <div class="an-panel__corpo">

            <div class="an-stats">

                <div class="an-stat">
                    <span class="an-stat__rotulo">Horas por dia</span>
                    <div class="an-stat__valor">@consumo.HorasUsoDia.ToString("N2") <small>h</small></div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Dias por mês</span>
                    <div class="an-stat__valor">@consumo.DiasUsoMes.ToString("N0") <small>dias</small></div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Tarifa</span>
                    <div class="an-stat__valor">R$ @consumo.TarifaKwh.ToString("N2") <small>/ kWh</small></div>
                </div>
            </div>

        </div>

    </details>

    <details class="an-panel">

        <summary>

            <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg></span>

            <span class="an-panel__texto">
                <span class="an-kicker">RESULTADOS</span>
                <h2>Consumo energético</h2>
            </span>

            <span class="an-panel__seta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span>

        </summary>

        <div class="an-panel__corpo">

            <div class="an-stats">

                <div class="an-stat">
                    <span class="an-stat__rotulo">Consumo mensal</span>
                    <div class="an-stat__valor">@consumo.ConsumoKwhMes.ToString("N2") <small>kWh/mês</small></div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Consumo diário</span>
                    <div class="an-stat__valor">@Model.ConsumoDiario.ToString("N2") <small>kWh/dia</small></div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Consumo por hora</span>
                    <div class="an-stat__valor">@Model.ConsumoPorHora.ToString("N2") <small>kWh/h</small></div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Consumo anual</span>
                    <div class="an-stat__valor">@Model.ConsumoAnual.ToString("N2") <small>kWh/ano</small></div>
                </div>
            </div>

        </div>

    </details>

    <details class="an-panel">

        <summary>

            <span class="an-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1" /><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" /></svg></span>

            <span class="an-panel__texto">
                <span class="an-kicker">FINANCEIRO</span>
                <h2>Custos estimados</h2>
            </span>

            <span class="an-panel__seta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span>

        </summary>

        <div class="an-panel__corpo">

            <div class="an-stats">

                <div class="an-stat">
                    <span class="an-stat__rotulo">Custo por hora</span>
                    <div class="an-stat__valor">R$ @Model.CustoPorHora.ToString("N2")</div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Custo diário</span>
                    <div class="an-stat__valor">R$ @Model.CustoDiario.ToString("N2")</div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Custo mensal</span>
                    <div class="an-stat__valor">R$ @Model.CustoMensal.ToString("N2")</div>
                </div>
                <div class="an-stat">
                    <span class="an-stat__rotulo">Custo anual</span>
                    <div class="an-stat__valor">R$ @Model.CustoAnual.ToString("N2")</div>
                </div>
            </div>

        </div>

    </details>


    <div class="details-footer-actions end">

        <div class="details-footer-group">

            <a asp-action="Analises"
               class="form-cancel">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@consumo.IdConsumo"
               class="form-submit">
                Editar consumo
            </a>

        </div>

    </div>

</div>
