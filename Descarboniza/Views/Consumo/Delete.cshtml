@model Descarboniza.Areas.Identity.Data.Consumo

@{
    ViewData["Title"] = "Excluir Consumo";
}

<div class="data-page consumo-delete-page">

    <div class="data-page-header">

        <div class="data-page-title-wrap">

            <span class="data-page-kicker">GESTÃO ENERGÉTICA</span>

            <h1>Excluir consumo</h1>

            <p class="data-page-description">
                Confirme a exclusão deste registro de consumo.
            </p>

        </div>

    </div>


    <div class="delete-warning-card">

        <div class="delete-warning-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
                <path d="M10.3 3.5 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.5a2 2 0 0 0-3.4 0Z" />
            </svg>

        </div>

        <div>

            <h2>Tem certeza que deseja excluir?</h2>

            <p>
                Esta ação removerá o registro de consumo e não poderá ser desfeita.
            </p>

        </div>

    </div>


    <div class="data-details-card">

        <div class="details-section">

            <span class="details-section-title">
                Registro
            </span>

            <div class="details-row">

                <span class="details-label">
                    Máquina
                </span>

                <span class="details-value">

                    @if (Model.Maquina != null)
                    {
                        @($"{Model.Maquina.Fabricante} - {Model.Maquina.Modelo}")
                    }
                    else
                    {
                        <span>Máquina não encontrada</span>
                    }

                </span>

            </div>


            <div class="details-row">

                <span class="details-label">
                    Data do registro
                </span>

                <span class="details-value">
                    @Model.DataRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </span>

            </div>

        </div>


        <div class="details-section">

            <span class="details-section-title">
                Consumo
            </span>

            <div class="details-grid details-grid-2">

                <div class="details-stat highlight">

                    <span>Consumo mensal</span>

                    <strong>
                        @Model.ConsumoKwhMes.ToString("N2")
                    </strong>

                    <small>kWh</small>

                </div>


                <div class="details-stat">

                    <span>Tarifa</span>

                    <strong>
                        R$ @Model.TarifaKwh.ToString("N2")
                    </strong>

                    <small>por kWh</small>

                </div>

            </div>

        </div>

    </div>


    <form asp-action="Delete" method="post" class="delete-actions">

        <input type="hidden" asp-for="IdConsumo" />

        <a asp-action="Index"
           class="form-cancel">
            Cancelar
        </a>

        <button type="submit"
                class="delete-confirm">
            Excluir consumo
        </button>

    </form>

</div>