@model Descarboniza.Areas.Identity.Data.Maquina

@{
    ViewData["Title"] = "Detalhes da Máquina";
}

<div class="data-page maquina-details-page">

    <div class="data-page-header">

        <div class="data-page-title-wrap">

            <span class="data-page-kicker">GESTÃO DE ATIVOS</span>

            <h1>Detalhes da máquina</h1>

            <p class="data-page-description">
                Visualize as informações cadastradas deste equipamento.
            </p>

        </div>

    </div>


    <div class="data-details-card">

        <div class="details-section">

            <span class="details-section-title">
                Equipamento
            </span>

            <div class="details-row">

                <span class="details-label">
                    Fabricante
                </span>

                <span class="details-value">
                    @Model.Fabricante
                </span>

            </div>


            <div class="details-row">

                <span class="details-label">
                    Modelo
                </span>

                <span class="details-value">
                    @Model.Modelo
                </span>

            </div>

        </div>


        <div class="details-section">

            <span class="details-section-title">
                Dados elétricos
            </span>

            <div class="details-grid">

                <div class="details-stat">

                    <span>Potência</span>

                    <strong>
                        @Model.Potencia.ToString("N2")
                    </strong>

                    <small>kW</small>

                </div>


                <div class="details-stat">

                    <span>Tensão</span>

                    <strong>
                        @Model.Tensao.ToString("N2")
                    </strong>

                    <small>V</small>

                </div>


                <div class="details-stat">

                    <span>Corrente</span>

                    <strong>
                        @Model.Corrente.ToString("N2")
                    </strong>

                    <small>A</small>

                </div>

            </div>

        </div>


        <div class="details-section">

            <span class="details-section-title">
                Cadastro
            </span>

            <div class="details-row">

                <span class="details-label">
                    Data de cadastro
                </span>

                <span class="details-value">
                    @Model.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </span>

            </div>

        </div>

    </div>


    <div class="details-footer-actions">

        <a asp-action="Delete"
           asp-route-id="@Model.IdMaquina"
           class="details-delete-link">
            Excluir máquina
        </a>

        <div class="details-footer-group">

            <a asp-action="Index"
               class="form-cancel">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdMaquina"
               class="form-submit">
                Editar máquina
            </a>

        </div>

    </div>

</div>