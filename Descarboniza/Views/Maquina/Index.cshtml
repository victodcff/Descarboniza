@model IEnumerable<Descarboniza.Areas.Identity.Data.Maquina>

@{
    ViewData["Title"] = "Máquinas";
}

<div class="data-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">GESTÃO DE ATIVOS</span>

            <h1>Minhas máquinas</h1>

            <p class="data-page-description">
                Gerencie os equipamentos cadastrados e acompanhe seus dados técnicos.
            </p>
        </div>

        <a asp-action="Create" class="data-page-action">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>

            Nova máquina
        </a>
    </div>


    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th class="text-end">Potência</th>
                        <th class="text-end">Tensão</th>
                        <th class="text-end">Corrente</th>
                        <th>Cadastro</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <div class="table-entity">
                                        <div class="table-entity-icon">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="3" />
                                                <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.5v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.5h.4a1.7 1.7 0 0 0 1.6-1A1.7 1.7 0 0 0 7.7 8l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1.9-1.6V5h2.5v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z" />
                                            </svg>
                                        </div>

                                        <div>
                                            <span class="table-primary-text">
                                                @item.Fabricante
                                            </span>

                                            <span class="table-secondary-text">
                                                @item.Modelo
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td class="table-number">
                                    @item.Potencia.ToString("N2")
                                    <span class="table-unit">kW</span>
                                </td>

                                <td class="table-number">
                                    @item.Tensao.ToString("N2")
                                    <span class="table-unit">V</span>
                                </td>

                                <td class="table-number">
                                    @item.Corrente.ToString("N2")
                                    <span class="table-unit">A</span>
                                </td>

                                <td class="table-date">
                                    @item.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdMaquina"
                                           class="table-action edit"
                                           title="Editar"
                                           aria-label="Editar máquina">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>

                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdMaquina"
                                           class="table-action view"
                                           title="Visualizar"
                                           aria-label="Visualizar máquina">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdMaquina"
                                           class="table-action delete"
                                           title="Excluir"
                                           aria-label="Excluir máquina">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5" />
                                                <path d="M14 11v5" />
                                            </svg>

                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="table-empty">

                                <div class="table-empty-icon">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.7"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="3" />
                                        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.5v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.5h.4a1.7 1.7 0 0 0 1.6-1A1.7 1.7 0 0 0 7.7 8l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V5h2.5v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z" />
                                    </svg>
                                </div>

                                <div class="table-empty-title">
                                    Nenhuma máquina cadastrada
                                </div>

                                <div class="table-empty-text">
                                    Cadastre sua primeira máquina para começar.
                                </div>

                                <a asp-action="Create" class="table-empty-action">
                                    Cadastrar máquina
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="table-footer">
            <span>
                @Model.Count() máquina(s) cadastrada(s)
            </span>
        </div>

    </div>

</div>