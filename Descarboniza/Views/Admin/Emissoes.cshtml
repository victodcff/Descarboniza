@model Descarboniza.ViewModels.AdminListaViewModel<Descarboniza.ViewModels.AdminEmissaoItem>

@{
    ViewData["Title"] = "Emissões (admin)";
}

<div class="data-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">ADMINISTRAÇÃO</span>

            <h1>Emissões</h1>

            <p class="data-page-description">
                Emissões de carbono calculadas para todos os usuários.
            </p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminFiltro", new Descarboniza.ViewModels.AdminFiltroViewModel
    {
        Acao = "Emissoes",
        Filtro = Model.UsuarioFiltro,
        Usuarios = Model.Usuarios
    })

    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th>Usuário</th>
                        <th class="text-end">Consumo</th>
                        <th class="text-end">Fator</th>
                        <th class="text-end">Emissão</th>
                        <th>Registro</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Itens.Any())
                    {
                        foreach (var item in Model.Itens)
                        {
                            var textoExcluir = "A emissão da máquina " + item.Emissao.Maquina?.Fabricante + " " + item.Emissao.Maquina?.Modelo + " de " + item.Dono + " será excluída. Esta ação não pode ser desfeita.";

                            <tr>

                                <td>
                                    <span class="table-primary-text">@item.Emissao.Maquina?.Fabricante</span>
                                    <span class="table-secondary-text">@item.Emissao.Maquina?.Modelo</span>
                                </td>

                                <td>
                                    <span class="table-primary-text">@item.Dono</span>
                                    <span class="table-secondary-text">@item.DonoEmail</span>
                                </td>

                                <td class="table-number">
                                    @item.Emissao.ConsumoKwh.ToString("N2")
                                    <span class="table-unit">kWh</span>
                                </td>

                                <td class="table-number">
                                    @item.Emissao.FatorEmissao.ToString("N5")
                                    <span class="table-unit">kg CO₂/kWh</span>
                                </td>

                                <td class="table-number">
                                    @item.Emissao.EmissaoKgCo2.ToString("N2")
                                    <span class="table-unit">kg CO₂</span>
                                </td>

                                <td class="table-date">
                                    @item.Emissao.DataRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="EditEmissao"
                                           asp-route-id="@item.Emissao.IdEmissao"
                                           class="table-action edit"
                                           title="Editar"
                                           aria-label="Editar emissão">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>
                                        </a>

                                        <button type="button"
                                                class="table-action delete"
                                                title="Excluir"
                                                aria-label="Excluir emissão"
                                                data-excluir-url="@Url.Action("ExcluirEmissao", "Admin", new { id = item.Emissao.IdEmissao })"
                                                data-excluir-titulo="Excluir emissão?"
                                                data-excluir-texto="@textoExcluir">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5" />
                                                <path d="M14 11v5" />
                                            </svg>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="table-empty">
                                <div class="table-empty-title">Nenhuma emissão encontrada</div>
                                <div class="table-empty-text">Não há registros para o filtro escolhido.</div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<partial name="_AdminExcluir" />
