@model Descarboniza.Areas.Identity.Data.Consumo

@{
    ViewData["Title"] = "Editar consumo (admin)";
}

<div class="data-page consumo-form-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">ADMINISTRAÇÃO</span>

            <h1>Editar consumo</h1>

            <p class="data-page-description">
                Atualize os dados de utilização e consumo do equipamento.
            </p>
        </div>
    </div>


    <div class="data-form-card">

        <form asp-action="EditConsumo" asp-route-id="@Model.IdConsumo" id="editForm">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdConsumo" />


            <div class="form-section">

                <div class="form-section-title">Equipamento</div>

                <div class="form-grid-2">

                    <div class="form-group">
                        <label class="form-label" for="MaquinaNome">Máquina</label>

                        <input type="text"
                               id="MaquinaNome"
                               class="form-control"
                               value="@Model.Maquina?.Fabricante - @Model.Maquina?.Modelo"
                               readonly
                               tabindex="-1" />

                        <span class="form-hint">A máquina do consumo não pode ser alterada.</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="Dono">Usuário</label>

                        <input type="text"
                               id="Dono"
                               class="form-control"
                               value="@ViewBag.Dono"
                               readonly
                               tabindex="-1" />
                    </div>

                </div>

                <div class="form-group">
                    <label class="form-label" for="DataAtual">Data do registro</label>

                    <input type="text"
                           id="DataAtual"
                           class="form-control"
                           value="@Model.DataRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")"
                           readonly
                           tabindex="-1" />
                </div>

            </div>


            <div class="form-section">

                <div class="form-section-title">Utilização</div>

                <div class="form-grid-2">

                    <div class="form-group">
                        <label asp-for="HorasUsoDia" class="form-label">Horas por dia</label>
                        <div class="input-with-unit">
                            <input asp-for="HorasUsoDia" type="text" inputmode="decimal" class="form-control decimal" data-val="false" />
                            <span>h</span>
                        </div>
                        <span asp-validation-for="HorasUsoDia" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DiasUsoMes" class="form-label">Dias por mês</label>
                        <div class="input-with-unit">
                            <input asp-for="DiasUsoMes" type="text" inputmode="decimal" class="form-control decimal" data-val="false" />
                            <span>dias</span>
                        </div>
                        <span asp-validation-for="DiasUsoMes" class="text-danger"></span>
                    </div>

                </div>

            </div>


            <div class="form-section">

                <div class="form-section-title">Consumo</div>

                <div class="form-grid-2">

                    <div class="form-group">
                        <label asp-for="ConsumoKwhMes" class="form-label">Consumo mensal</label>
                        <div class="input-with-unit">
                            <input asp-for="ConsumoKwhMes" type="text" inputmode="decimal" class="form-control decimal" data-val="false" />
                            <span>kWh</span>
                        </div>
                        <span asp-validation-for="ConsumoKwhMes" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TarifaKwh" class="form-label">Tarifa</label>
                        <div class="input-with-unit">
                            <input asp-for="TarifaKwh" type="text" inputmode="decimal" class="form-control decimal" data-val="false" />
                            <span>R$/kWh</span>
                        </div>
                        <span asp-validation-for="TarifaKwh" class="text-danger"></span>
                    </div>

                </div>

            </div>


            <div class="form-actions">

                <a asp-action="Consumos" class="form-cancel">Cancelar</a>

                <button type="submit" class="form-submit">Salvar alterações</button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const form = document.getElementById("editForm");

        document.querySelectorAll(".decimal").forEach(function (campo) {
            campo.value = campo.value.replace(".", ",");
        });

        form.addEventListener("submit", function () {
            document.querySelectorAll(".decimal").forEach(function (campo) {
                campo.value = campo.value.replace(".", ",");
            });
        });

    </script>
}
