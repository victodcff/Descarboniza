@model IEnumerable<Descarboniza.ViewModels.AdminUsuarioItem>

@{
    ViewData["Title"] = "Usuários";
}

<div class="data-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">ADMINISTRAÇÃO</span>

            <h1>Usuários</h1>

            <p class="data-page-description">
                Todas as contas do sistema. Excluir um usuário apaga também as máquinas, consumos e emissões dele.
            </p>
        </div>
    </div>


    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th class="text-end">Máquinas</th>
                        <th>Tipo</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var textoExcluir = item.Usuario.NomeCompleto + " e todas as máquinas, consumos e emissões dele serão excluídos. Esta ação não pode ser desfeita.";

                        <tr>

                            <td>
                                <span class="table-primary-text">@item.Usuario.NomeCompleto</span>
                                <span class="table-secondary-text">@item.Usuario.Email</span>
                            </td>

                            <td class="table-number">@item.QtdMaquinas</td>

                            <td>
                                @if (item.EhAdmin)
                                {
                                    <span class="table-badge warn">Administrador</span>
                                }
                                else
                                {
                                    <span class="table-badge muted">Usuário</span>
                                }
                            </td>

                            <td>
                                <div class="table-actions">

                                    @if (!item.EhAdmin)
                                    {
                                        <a asp-action="Maquinas"
                                           asp-route-usuario="@item.Usuario.Id"
                                           class="table-action view"
                                           title="Ver máquinas"
                                           aria-label="Ver máquinas do usuário">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        </a>

                                        <a asp-action="EditarUsuario"
                                           asp-route-id="@item.Usuario.Id"
                                           class="table-action edit"
                                           title="Editar"
                                           aria-label="Editar usuário">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>
                                        </a>

                                        <button type="button"
                                                class="table-action delete"
                                                title="Excluir"
                                                aria-label="Excluir usuário"
                                                data-excluir-url="@Url.Action("ExcluirUsuario", "Admin", new { id = item.Usuario.Id })"
                                                data-excluir-titulo="Excluir usuário?"
                                                data-excluir-texto="@textoExcluir">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5" />
                                                <path d="M14 11v5" />
                                            </svg>
                                        </button>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<partial name="_AdminExcluir" />
