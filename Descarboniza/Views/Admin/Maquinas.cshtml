@model Descarboniza.ViewModels.AdminListaViewModel<Descarboniza.ViewModels.AdminMaquinaItem>

@{
    ViewData["Title"] = "Máquinas (admin)";
}

<div class="data-page">

    <div class="data-page-header">
        <div class="data-page-title-wrap">
            <span class="data-page-kicker">ADMINISTRAÇÃO</span>

            <h1>Máquinas</h1>

            <p class="data-page-description">
                Equipamentos cadastrados por todos os usuários.
            </p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminFiltro", new Descarboniza.ViewModels.AdminFiltroViewModel
    {
        Acao = "Maquinas",
        Filtro = Model.UsuarioFiltro,
        Usuarios = Model.Usuarios
    })

    <div class="data-table-card">

        <div class="data-table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th>Usuário</th>
                        <th class="text-end">Potência</th>
                        <th class="text-end">Tensão</th>
                        <th class="text-end">Corrente</th>
                        <th>Cadastro</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Itens.Any())
                    {
                        foreach (var item in Model.Itens)
                        {
                            var textoExcluir = "A máquina " + item.Maquina.Fabricante + " " + item.Maquina.Modelo + " de " + item.Dono + " e seus consumos e emissões serão excluídos. Esta ação não pode ser desfeita.";

                            <tr>

                                <td>
                                    <span class="table-primary-text">@item.Maquina.Fabricante</span>
                                    <span class="table-secondary-text">@item.Maquina.Modelo</span>
                                </td>

                                <td>
                                    <span class="table-primary-text">@item.Dono</span>
                                    <span class="table-secondary-text">@item.DonoEmail</span>
                                </td>

                                <td class="table-number">
                                    @item.Maquina.Potencia.ToString("N2")
                                    <span class="table-unit">kW</span>
                                </td>

                                <td class="table-number">
                                    @item.Maquina.Tensao.ToString("N2")
                                    <span class="table-unit">V</span>
                                </td>

                                <td class="table-number">
                                    @item.Maquina.Corrente.ToString("N2")
                                    <span class="table-unit">A</span>
                                </td>

                                <td class="table-date">
                                    @item.Maquina.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="EditMaquina"
                                           asp-route-id="@item.Maquina.IdMaquina"
                                           class="table-action edit"
                                           title="Editar"
                                           aria-label="Editar máquina">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>
                                        </a>

                                        <button type="button"
                                                class="table-action delete"
                                                title="Excluir"
                                                aria-label="Excluir máquina"
                                                data-excluir-url="@Url.Action("ExcluirMaquina", "Admin", new { id = item.Maquina.IdMaquina })"
                                                data-excluir-titulo="Excluir máquina?"
                                                data-excluir-texto="@textoExcluir">
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5" />
                                                <path d="M14 11v5" />
                                            </svg>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="table-empty">
                                <div class="table-empty-title">Nenhuma máquina encontrada</div>
                                <div class="table-empty-text">Não há máquinas para o filtro escolhido.</div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<partial name="_AdminExcluir" />
