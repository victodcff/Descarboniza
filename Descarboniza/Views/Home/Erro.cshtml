@{
    var codigo = ViewData["Codigo"] is int c ? c : 404;
    var titulo = ViewData["Titulo"] as string ?? "Página não encontrada";
    var mensagem = ViewData["Mensagem"] as string ?? "O endereço que você tentou acessar não existe ou foi movido.";

    ViewData["Title"] = titulo;

    // Códigos como 404, 403 e 500 têm um zero no meio: nele entra a logo.
    var texto = codigo.ToString();
    var comLogo = texto.Length == 3 && texto[1] == '0';
}

<style>
    /* Deslogado não há barra lateral: libera o espaço reservado a ela */
    body:has(.dsc-erro):not(:has(.sidebar)) .main-content {
        width: 100%;
        margin-left: 0;
    }

    body:has(.dsc-erro):not(:has(.sidebar)) .content-area {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .dsc-erro {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        padding: 16px 0;
    }

    .dsc-erro__card {
        width: 100%;
        max-width: 480px;
        padding: 40px 34px 34px;
        border: 1px solid #dfe5e1;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 18px 50px rgba(24, 40, 30, .08);
        text-align: center;
    }

    .dsc-erro__numero {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin: 0 0 8px;
        color: #4d9f20;
        font-size: 96px;
        font-weight: 750;
        line-height: 1;
        letter-spacing: -2px;
    }

        .dsc-erro__numero .dsc-logo {
            --dsc-logo-size: 92px;
        }

    .dsc-erro__titulo {
        margin: 14px 0 0;
        color: #18201c;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: -.6px;
    }

    .dsc-erro__texto {
        margin: 10px 0 28px;
        color: #55615a;
        font-size: 15px;
        line-height: 1.6;
    }

    .dsc-erro__acoes {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .dsc-erro__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 22px;
        border: 1px solid #cfd8d2;
        border-radius: 10px;
        background: transparent;
        color: #18201c;
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }

        .dsc-erro__btn:hover {
            border-color: #4d9f20;
            color: #3f8a17;
            text-decoration: none;
        }

    .dsc-erro__btn--principal {
        border-color: #4d9f20;
        background: #4d9f20;
        color: #fff;
    }

        .dsc-erro__btn--principal:hover {
            border-color: #3f8a17;
            background: #3f8a17;
            color: #fff;
        }

    html[data-theme="dark"] .dsc-erro__card {
        border-color: #2b352e;
        background: #1a211d;
        box-shadow: none;
    }

    html[data-theme="dark"] .dsc-erro__numero {
        color: #7bcf38;
    }

    html[data-theme="dark"] .dsc-erro__titulo {
        color: #e8efe9;
    }

    html[data-theme="dark"] .dsc-erro__texto {
        color: #aeb8b1;
    }

    html[data-theme="dark"] .dsc-erro__btn {
        border-color: #3a463e;
        color: #e8efe9;
    }

        html[data-theme="dark"] .dsc-erro__btn:hover {
            border-color: #7bcf38;
            color: #7bcf38;
        }

    html[data-theme="dark"] .dsc-erro__btn--principal {
        border-color: #4d9f20;
        background: #4d9f20;
        color: #fff;
    }

        html[data-theme="dark"] .dsc-erro__btn--principal:hover {
            border-color: #5fb52a;
            background: #5fb52a;
            color: #fff;
        }

    @@media (max-width: 520px) {
        .dsc-erro__card {
            padding: 30px 20px 26px;
        }

        .dsc-erro__numero {
            font-size: 68px;
        }

            .dsc-erro__numero .dsc-logo {
                --dsc-logo-size: 66px;
            }

        .dsc-erro__titulo {
            font-size: 22px;
        }

        .dsc-erro__btn {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: no-preference) {
        .dsc-erro__card {
            animation: dsc-erro-entrada .35s ease both;
        }
    }

    @@keyframes dsc-erro-entrada {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<div class="dsc-erro">

    <div class="dsc-erro__card">

        <div class="dsc-erro__numero" role="img" aria-label="Erro @codigo">

            @if (comLogo)
            {
                <span aria-hidden="true">@texto[0]</span>

                <img class="dsc-logo"
                     src="~/img/logo.png"
                     alt=""
                     asp-append-version="true" />

                <span aria-hidden="true">@texto[2]</span>
            }
            else
            {
                <span aria-hidden="true">@texto</span>
            }

        </div>

        <h1 class="dsc-erro__titulo">@titulo</h1>

        <p class="dsc-erro__texto">@mensagem</p>

        <div class="dsc-erro__acoes">

            <a asp-controller="Home"
               asp-action="Index"
               class="dsc-erro__btn dsc-erro__btn--principal">
                Voltar ao início
            </a>

            <button type="button"
                    class="dsc-erro__btn"
                    onclick="if (history.length > 1) { history.back(); } else { location.href = '@Url.Action("Index", "Home")'; }">
                Página anterior
            </button>

        </div>

    </div>

</div>
