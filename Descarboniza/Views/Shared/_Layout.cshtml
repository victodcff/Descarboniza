<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <meta name="theme-color" content="#18201c" />

    <title>
        @ViewData["Title"] - Descarboniza
    </title>

    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/pwa/apple-touch-icon.png" asp-append-version="true" />

    <!-- PWA: permite instalar o site como aplicativo -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Descarboniza" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/Descarboniza.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/sidebar.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/datapages.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/components.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/analise.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/mobile.css"
          asp-append-version="true" />

    <script>
            (function() {

                const tema =
                    localStorage.getItem("descarboniza-tema");

                if (tema === "dark") {

                    document.documentElement
                        .setAttribute("data-theme", "dark");

                }

            })();
    </script>

</head>

<body>

    @{
        var controllerAtual =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var actionAtual =
            ViewContext.RouteData.Values["action"]?.ToString();

        var ehAdmin = User.IsInRole("Admin");
    }

    <div class="app-layout">

        @if (User.Identity?.IsAuthenticated == true)
        {
            <header class="mobile-topbar">

                <button type="button"
                        id="menuToggle"
                        class="mobile-topbar__toggle"
                        aria-label="Abrir menu"
                        aria-controls="appSidebar"
                        aria-expanded="false">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M4 6h16" />
                        <path d="M4 12h16" />
                        <path d="M4 18h16" />
                    </svg>

                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="mobile-topbar__brand">

                    <img src="~/img/logo.png"
                         alt=""
                         asp-append-version="true" />

                    <b><span class="brand-des">DES</span>CARBONIZA</b>

                </a>

            </header>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <aside class="sidebar" id="appSidebar">

                <button type="button"
                        id="sidebarClose"
                        class="sidebar-close"
                        aria-label="Fechar menu">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M6 6l12 12" />
                        <path d="M18 6L6 18" />
                    </svg>

                </button>

                <!-- LOGO -->

                <div class="sidebar-brand">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="dsc-brand">

                        <img class="dsc-logo"
                             src="~/img/logo.png"
                             alt=""
                             asp-append-version="true" />

                        <b class="dsc-brand__text"><span class="brand-des">DES</span>CARBONIZA</b>

                    </a>

                </div>


                <!-- MENU -->

                <nav class="sidebar-nav">
                    @if (ehAdmin)
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="sidebar-link @(controllerAtual == "Admin" && actionAtual == "Index" ? "active" : "")">

                            <svg class="sidebar-svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />
                            </svg>

                            <span>Painel</span>

                        </a>

                        <a asp-controller="Admin"
                           asp-action="Usuarios"
                           class="sidebar-link @(controllerAtual == "Admin" && (actionAtual == "Usuarios" || actionAtual == "EditarUsuario") ? "active" : "")">

                            <svg class="sidebar-svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="9" cy="8" r="3.2" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M16 5.2a3.2 3.2 0 0 1 0 5.6" /><path d="M18 14.4c1.8.8 3 2.6 3 5.6" />
                            </svg>

                            <span>Usuários</span>

                        </a>

                        <a asp-controller="Admin"
                           asp-action="Maquinas"
                           class="sidebar-link @(controllerAtual == "Admin" && (actionAtual == "Maquinas" || actionAtual == "EditMaquina") ? "active" : "")">

                            <svg class="sidebar-svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />
                            </svg>

                            <span>Máquinas</span>

                        </a>

                        <a asp-controller="Admin"
                           asp-action="Consumos"
                           class="sidebar-link @(controllerAtual == "Admin" && (actionAtual == "Consumos" || actionAtual == "EditConsumo") ? "active" : "")">

                            <svg class="sidebar-svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />
                            </svg>

                            <span>Consumos</span>

                        </a>

                        <a asp-controller="Admin"
                           asp-action="Emissoes"
                           class="sidebar-link @(controllerAtual == "Admin" && (actionAtual == "Emissoes" || actionAtual == "EditEmissao") ? "active" : "")">

                            <svg class="sidebar-svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M20 4c-8.5.5-13.5 4-13.5 9.5 0 3.5 2.5 6 6 6 5.5 0 7-6 7.5-15.5z" /><path d="M4 21c2.5-5 6-8 11-10" />
                            </svg>

                            <span>Emissões</span>

                        </a>
                    }
                    else
                    {

                    <!-- HOME -->

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Home" && actionAtual == "Index" ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M3 10.5L12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9 21v-6h6v6" />

                        </svg>

                        <span>Home</span>

                    </a>


                    <!-- DASHBOARD -->

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Dashboard" ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3" y="3" width="7" height="7" />
                            <rect x="14" y="3" width="7" height="7" />
                            <rect x="3" y="14" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" />

                        </svg>

                        <span>Dashboard</span>

                    </a>


                    <!-- MÁQUINAS -->

                    <a asp-controller="Maquina"
                       asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Maquina" ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12" cy="12" r="3" />

                            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.5v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.5h.4a1.7 1.7 0 0 0 1.6-1A1.7 1.7 0 0 0 7.7 8l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V5h2.5v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z" />

                        </svg>

                        <span>Máquinas</span>

                    </a>


                    <!-- CONSUMO -->

                    <a asp-controller="Consumo"
                       asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Consumo" && actionAtual != "Analise" && actionAtual != "Analises" ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />

                        </svg>

                        <span>Consumo</span>

                    </a>


                    <!-- EMISSÕES -->

                    <a asp-controller="EmissaoCarbono"
                       asp-action="Index"
                       class="sidebar-link @(controllerAtual == "EmissaoCarbono" ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M20 4c-8.5.5-13.5 4-13.5 9.5 0 3.5 2.5 6 6 6 5.5 0 7-6 7.5-15.5z" />

                            <path d="M4 21c2.5-5 6-8 11-10" />

                        </svg>

                        <span>Emissões</span>

                    </a>


                    <!-- ANÁLISES -->

                    <a asp-controller="Consumo"
                       asp-action="Analises"
                       class="sidebar-link @(controllerAtual == "Consumo" && (actionAtual == "Analise" || actionAtual == "Analises") ? "active" : "")">

                        <svg class="sidebar-svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 19V5" />
                            <path d="M4 19h16" />
                            <path d="M7 15l3-4 3 2 5-7" />

                        </svg>

                        <span>Análises</span>

                    </a>

                }

                </nav>


                <!-- ÁREA CENTRAL -->

                <div class="sidebar-middle">

                    <div class="sidebar-highlight">

                        <span class="sidebar-highlight-label">
                            NOSSO PROPÓSITO
                        </span>

                        <h3>
                            Menos carbono.<br>
                            Mais eficiência.<br>
                            <span>Mais futuro.</span>
                        </h3>

                        <p>
                            Gestão energética mais inteligente e sustentável.
                        </p>

                        <div class="sidebar-highlight-line"></div>

                    </div>

                </div>


                <!-- ÁREA INFERIOR -->

                <div class="sidebar-bottom">

                    <div class="theme-selector">

                        <button type="button"
                                id="themeToggle"
                                class="theme-toggle"
                                aria-label="Ativar modo escuro"
                                title="Modo escuro">

                            <svg class="theme-icon-sun"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="12" cy="12" r="4" />

                                <path d="M12 2v2" />
                                <path d="M12 20v2" />
                                <path d="m4.93 4.93 1.41 1.41" />
                                <path d="m17.66 17.66 1.41 1.41" />
                                <path d="M2 12h2" />
                                <path d="M20 12h2" />
                                <path d="m6.34 17.66-1.41 1.41" />
                                <path d="m19.07 4.93-1.41 1.41" />

                            </svg>

                            <svg class="theme-icon-moon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="display:none;">

                                <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.7 6.7 0 0 0 9.8 9.8Z" />

                            </svg>

                        </button>

                    </div>

                    <partial name="_LoginPartial" />

                </div>

            </aside>
        }


        <!-- CONTEÚDO -->

        <div class="main-content">

            <main role="main"
                  class="content-area">

                @RenderBody()

            </main>


            @if (User.Identity?.IsAuthenticated == true)
            {
                <footer class="footer">

                    <div>
                        &copy; 2026 - Descarboniza -

                        <a asp-controller="Home"
                           asp-action="Privacy">

                            Privacidade

                        </a>
                    </div>

                </footer>
            }

        </div>

    </div>

    <partial name="_Toast" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <script src="~/js/forms.js"
            asp-append-version="true">
    </script>

    <script src="~/js/toast.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            // PWA: registra o service worker (só funciona em HTTPS ou localhost)
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", function () {
                    navigator.serviceWorker
                        .register("@Url.Content("~/sw.js")")
                        .catch(function () { });
                });
            }
    </script>


</body>

</html>