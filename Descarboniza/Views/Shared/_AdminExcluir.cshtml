@* Janela de confirmação de exclusão do painel admin.
   Qualquer botão com data-excluir-url, data-excluir-titulo e data-excluir-texto abre esta janela. *@

<dialog id="admExcluirDialog"
        class="dsc-dialog"
        aria-labelledby="admExcluirTitulo">

    <form method="post" id="admExcluirForm">

        @Html.AntiForgeryToken()

        <div class="dsc-dialog__body">

            <div class="dsc-dialog__icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M3 6h18" />
                    <path d="M8 6V4h8v2" />
                    <path d="M19 6l-1 14H6L5 6" />
                    <path d="M10 11v5" />
                    <path d="M14 11v5" />
                </svg>

            </div>

            <h2 id="admExcluirTitulo" class="dsc-dialog__title">
                Excluir registro?
            </h2>

            <p id="admExcluirTexto" class="dsc-dialog__text"></p>

        </div>

        <div class="dsc-dialog__actions">

            <button type="button"
                    class="form-cancel"
                    data-fechar
                    autofocus>
                Cancelar
            </button>

            <button type="submit"
                    class="form-submit delete-confirm">
                Excluir
            </button>

        </div>

    </form>

</dialog>

<script>
    (function () {

        var dialogo = document.getElementById("admExcluirDialog");
        var formulario = document.getElementById("admExcluirForm");

        if (!dialogo || !formulario || typeof dialogo.showModal !== "function") {
            return;
        }

        document.addEventListener("click", function (evento) {

            var botao = evento.target.closest("[data-excluir-url]");

            if (!botao) {
                return;
            }

            formulario.setAttribute("action", botao.getAttribute("data-excluir-url"));

            document.getElementById("admExcluirTitulo").textContent =
                botao.getAttribute("data-excluir-titulo") || "Excluir registro?";

            document.getElementById("admExcluirTexto").textContent =
                botao.getAttribute("data-excluir-texto") || "Esta ação não pode ser desfeita.";

            dialogo.showModal();

        });

        dialogo.querySelector("[data-fechar]").addEventListener("click", function () {
            dialogo.close();
        });

        dialogo.addEventListener("click", function (evento) {
            if (evento.target === dialogo) {
                dialogo.close();
            }
        });

    })();
</script>
